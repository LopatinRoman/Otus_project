<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_HR_Onboarding_Hub" targetNamespace="http://example.local/bpmn/hr-onboarding-hub" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.12.0">
  <bpmn:message id="Message_RMQ_Command" name="Команда этапа (RMQ)" />
  <bpmn:message id="Message_RMQ_Reply" name="Ответ по этапу (RMQ)" />
  <bpmn:collaboration id="Collaboration_Hub_IT">
    <bpmn:participant id="Participant_Hub" name="HR Onboarding Hub (1С)" processRef="Process_Hub" />
    <bpmn:participant id="Participant_IT" name="ИТ-исполнитель (1С: Управление задачами)" processRef="Process_IT" />
    <bpmn:messageFlow id="MsgFlow_Command" name="Команда: access.create / asset.issue" sourceRef="Task_SendCommand" targetRef="Start_IT_Command" messageRef="Message_RMQ_Command" />
    <bpmn:messageFlow id="MsgFlow_Reply" name="Ответ: success / error" sourceRef="Event_IT_SendReply" targetRef="Task_ReceiveReply" messageRef="Message_RMQ_Reply" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hub" name="Онбординг сотрудника (MVP)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hub">
      <bpmn:lane id="Lane_System" name="1С: Библиотека стандартных подсистем">
        <bpmn:flowNodeRef>Task_GenerateStages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreStages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCommand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectNextStage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_SLA_Overdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OverdueMarked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkOverdue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Start_Hub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitToWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetryStage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelRequest_UI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryOrCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_17bqkmf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1pbwbbv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Hub" name="Получение HR подтверждения приема сотрудника на работу" />
    <bpmn:userTask id="Task_CreateRequest" name="HR: создать заявку (Черновик)" />
    <bpmn:serviceTask id="Task_GenerateStages" name="Система: сформировать этапы онбординга" />
    <bpmn:exclusiveGateway id="Gateway_MoreStages" name="Остались этапы?" />
    <bpmn:serviceTask id="Task_SendCommand" name="Система: отправить команду в RMQ">
      <bpmn:incoming>Flow_9_error</bpmn:incoming>
      <bpmn:outgoing>Flow_0nyjgqy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SelectNextStage" name="Система: выбрать следующий этап" />
    <bpmn:serviceTask id="Task_CancelRequest" name="Система: заявка = Отменено" />
    <bpmn:serviceTask id="Task_CompleteRequest" name="Система: заявка = Завершено">
      <bpmn:outgoing>Flow_1mug634</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SubmitToWork" name="HR: отправить в работу" />
    <bpmn:userTask id="Task_RetryStage" name="HR: повторить отправку этапа" />
    <bpmn:userTask id="Task_CancelRequest_UI" name="HR: отменить заявку" />
    <bpmn:endEvent id="End_Canceled" name="Заявка отменена" />
    <bpmn:exclusiveGateway id="Gateway_RetryOrCancel" name="HR Отменяет заявку?" />
    <bpmn:serviceTask id="Task_MarkError" name="Система: этап = Ошибка, сохранить текст ошибки">
      <bpmn:incoming>Flow_0nyjgqy</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MarkDone" name="Система: этап = Выполнено, сохранить результат" />
    <bpmn:task id="Activity_17bqkmf" name="Уведомить сотрудника о готовности оборудования и доступов">
      <bpmn:incoming>Flow_1mug634</bpmn:incoming>
      <bpmn:outgoing>Flow_0p29ibe</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_1pbwbbv" name="Доступы и оборудование предоставлены">
      <bpmn:incoming>Flow_0p29ibe</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Hub" targetRef="Task_CreateRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateRequest" targetRef="Task_SubmitToWork" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SubmitToWork" targetRef="Task_GenerateStages" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GenerateStages" targetRef="Gateway_MoreStages" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_MarkDone" targetRef="Gateway_MoreStages" />
    <bpmn:sequenceFlow id="Flow_5_yes" name="Да" sourceRef="Gateway_MoreStages" targetRef="Task_SelectNextStage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5_no" name="Нет" sourceRef="Gateway_MoreStages" targetRef="Task_CompleteRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SelectNextStage" targetRef="Task_SendCommand" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RetryStage" targetRef="Task_SendCommand" />
    <bpmn:sequenceFlow id="Flow_9_error" name="Нет" sourceRef="Gateway_Success" targetRef="Task_SendCommand" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendCommand" targetRef="Task_ReceiveReply" />
    <bpmn:sequenceFlow id="Flow_0nyjgqy" sourceRef="Task_SendCommand" targetRef="Task_MarkError" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ReceiveReply" targetRef="Gateway_Success" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CancelRequest_UI" targetRef="Task_CancelRequest" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CancelRequest" targetRef="End_Canceled" />
    <bpmn:sequenceFlow id="Flow_1mug634" sourceRef="Task_CompleteRequest" targetRef="Activity_17bqkmf" />
    <bpmn:sequenceFlow id="Flow_12_retry" name="Нет" sourceRef="Gateway_RetryOrCancel" targetRef="Task_RetryStage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">повторить</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12_cancel" name="Да" sourceRef="Gateway_RetryOrCancel" targetRef="Task_CancelRequest_UI">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">отменить</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_MarkError" targetRef="Gateway_RetryOrCancel" />
    <bpmn:sequenceFlow id="Flow_9_success" name="Да" sourceRef="Gateway_Success" targetRef="Task_MarkDone" />
    <bpmn:sequenceFlow id="Flow_0yyo135" sourceRef="Boundary_SLA_Overdue" targetRef="Task_MarkOverdue" />
    <bpmn:sequenceFlow id="Flow_0x320tr" sourceRef="Task_MarkOverdue" targetRef="End_OverdueMarked" />
    <bpmn:sequenceFlow id="Flow_0p29ibe" sourceRef="Activity_17bqkmf" targetRef="Event_1pbwbbv" />
    <bpmn:receiveTask id="Task_ReceiveReply" name="Система: получить ответ из RMQ" messageRef="Message_RMQ_Reply" />
    <bpmn:boundaryEvent id="Boundary_SLA_Overdue" name="Дедлайн SLA этапа" cancelActivity="false" attachedToRef="Task_ReceiveReply">
      <bpmn:outgoing>Flow_0yyo135</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_Success" name="Ответ успешен?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9_success</bpmn:outgoing>
      <bpmn:outgoing>Flow_9_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="End_OverdueMarked" name="Просрочка отмечена">
      <bpmn:incoming>Flow_0x320tr</bpmn:incoming>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_MarkOverdue" name="Система: отметить этап как просроченный (SLA)">
      <bpmn:incoming>Flow_0yyo135</bpmn:incoming>
      <bpmn:outgoing>Flow_0x320tr</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="Process_IT" name="ИТ-исполнитель: обработка команды" isExecutable="false">
    <bpmn:serviceTask id="Task_IT_DoAction" name="ИТ: выполнить действие (учётка/права/оборудование)" />
    <bpmn:intermediateThrowEvent id="Event_IT_SendReply" name="Отправить ответ (RMQ)">
      <bpmn:messageEventDefinition messageRef="Message_RMQ_Reply" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="IT_Flow_1" sourceRef="Start_IT_Command" targetRef="Task_IT_DoAction" />
    <bpmn:sequenceFlow id="IT_Flow_2" sourceRef="Task_IT_DoAction" targetRef="Event_IT_SendReply" />
    <bpmn:startEvent id="Start_IT_Command" name="Команда этапа получена (RMQ)">
      <bpmn:outgoing>IT_Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0v0mdep" />
    </bpmn:startEvent>
  </bpmn:process>
