@startuml
' ER (PlantUML) — сокращённая версия (MVP-минимум) под текущую конфигурацию
' Только основные сущности и связи: сотрудники, заявки, этапы, пакеты, типы этапов.

hide methods
hide stereotypes
skinparam linetype ortho
left to right direction

entity "otus_Сотрудники" as EMP {
  *Ссылка
  --
  Наименование (ФИО)
  Подразделение
  Должность
}

entity "otus_ПакетыДоступов" as PKG {
  *Ссылка
  --
  Код
  Наименование
}

entity "otus_ПакетыДоступов.ТЧ Этапы" as PKG_STEPS {
  *ПакетДоступов (Ссылка)
  *НомерСтроки
  --
  ТипЭтапа (Ссылка)
  Порядок
  SLAЧасов
}

entity "otus_ТипыЭтапов" as STEP_TYPE {
  *Ссылка
  --
  Наименование
  СрокSLAЧасов
  ТипКомандыRMQ
}

entity "otus_ЗаявкаОнбординг" as DOC {
  *Ссылка
  --
  Номер
  Дата
  Сотрудник (Ссылка)
  ДатаВыхода
  ПакетДоступов (Ссылка)
  НужноОборудование
  Статус
}

entity "Otus_ЭтапыОнбординга (РС)" as STAGE_RS {
  *Заявка (Ссылка)
  *ТипЭтапа (Ссылка)
  *НомерЭтапа
  --
  СтатусЭтапа
  Дедлайн
  ДатаФакта
  Просрочен
  CorrelationId
  LastRequestId
}

EMP       ||--o{ DOC       : "Сотрудник"
PKG       ||--o{ DOC       : "ПакетДоступов"

PKG       ||--o{ PKG_STEPS : "ТЧ Этапы"
STEP_TYPE ||--o{ PKG_STEPS : "ТипЭтапа"

DOC       ||--o{ STAGE_RS  : "Этапы"
STEP_TYPE ||--o{ STAGE_RS  : "ТипЭтапа"

@enduml