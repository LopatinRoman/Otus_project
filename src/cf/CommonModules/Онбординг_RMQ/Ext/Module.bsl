Процедура ПроверитьПодключениеСервер(УникальныйИдентификатор,Сервер) экспорт
	
	КлиентКомпоненты = ПолучитьКомпонентуСервер(УникальныйИдентификатор);
	ПроверитьПодключение(КлиентКомпоненты, Сервер);
	
КонецПроцедуры

Функция ПолучитьКомпонентуСервер(УникальныйИдентификатор) экспорт
	
	КлиентКомпоненты = Неопределено;
	Если Не ИнициализироватьКомпоненту(КлиентКомпоненты) Тогда
		
		ПодключитьКомпонентуСервер(УникальныйИдентификатор);
		ИнициализироватьКомпоненту(КлиентКомпоненты);
		
	КонецЕсли;
	
	Возврат КлиентКомпоненты;
КонецФункции

Процедура ПодключитьКомпонентуСервер(УникальныйИдентификатор,КомпонентаПодключена = Неопределено)
	
	АдресВоВременномХранилище = ПолучитьАдресМакетаКомпановкиНаСервере(УникальныйИдентификатор);
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту(
			АдресВоВременномХранилище,
			"BITERP",
			ТипВнешнейКомпоненты.Native);
	//Сообщить(НСтр("ru = 'Компонента подключена!'"));
КонецПроцедуры

Функция ПолучитьАдресМакетаКомпановкиНаСервере(УникальныйИдентификатор)
	
	МакетВнешнейКомпоненты    = ПолучитьОбщийМакет("RMQ");
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(МакетВнешнейКомпоненты, УникальныйИдентификатор);
	
	Возврат АдресВоВременномХранилище;
	
КонецФункции

Функция ИнициализироватьКомпоненту(Компонента) экспорт
	
	Попытка
		Компонента  = Новый("AddIn.BITERP.PinkRabbitMQ_9");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ПроверитьПодключение(КлиентКомпоненты, Сервер) Экспорт
	
	Попытка
		СоединитьсяССервером(КлиентКомпоненты,Сервер);
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка подключения!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
	Сообщить(НСтр("ru = 'Подключение успешно выполнено!'"));
	
КонецПроцедуры

Процедура ОтправитьСообщение(КлиентКомпоненты, Сервер, Exchange, Message) Экспорт
	
		СоединитьсяССервером(КлиентКомпоненты,Сервер);

		ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
		КлючМаршрутизации  = ?(ЗначениеЗаполнено(Exchange.КлючМаршрутизации),Exchange.КлючМаршрутизации,"#");
		МетодОтправитьСообщение(КлиентКомпоненты,ТочкаОбмена,КлючМаршрутизации,Message,1,Ложь);
	

КонецПроцедуры

Процедура СозданиеТочкиИОчереди(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
			
	ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
	ОбъявитьТочкуОбмена(КлиентКомпоненты,ТочкаОбмена,?(ЗначениеЗаполнено(Exchange.Тип),Exchange.Тип,Неопределено));
	ИмяОчереди  = СокрЛП(Exchange.ИмяОчереди);
	КлючМаршрутизации  = ?(ЗначениеЗаполнено(Exchange.КлючМаршрутизации),Exchange.КлючМаршрутизации,"#");
	ОбъявитьОчередь(КлиентКомпоненты,ИмяОчереди);
	УстановитьСвязьОчереди(КлиентКомпоненты, ИмяОчереди, ТочкаОбмена, КлючМаршрутизации);
	
КонецПроцедуры

Процедура УстановитьСвязиТочкиОбменаИОчереди(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
			
	ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
//	ОбъявитьТочкуОбмена(КлиентКомпоненты,ТочкаОбмена,?(ЗначениеЗаполнено(Exchange.Тип),Exchange.Тип,Неопределено),Истина);
	ИмяОчереди  = СокрЛП(Exchange.ИмяОчереди);
	КлючМаршрутизации  = ?(ЗначениеЗаполнено(Exchange.КлючМаршрутизации),Exchange.КлючМаршрутизации,"#");
//	ОбъявитьОчередь(КлиентКомпоненты,ИмяОчереди,Истина);
	УстановитьСвязьОчереди(КлиентКомпоненты, ИмяОчереди, ТочкаОбмена, КлючМаршрутизации);
	
КонецПроцедуры




Процедура СозданиеОчереди(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
	ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
	ИмяОчереди  = СокрЛП(Exchange.ИмяОчереди);
	ОбъявитьОчередь(КлиентКомпоненты,ИмяОчереди);
	КлючМаршрутизации  = ?(ЗначениеЗаполнено(Exchange.КлючМаршрутизации),Exchange.КлючМаршрутизации,"#");
	УстановитьСвязьОчереди(КлиентКомпоненты, ИмяОчереди, ТочкаОбмена, КлючМаршрутизации);
	
КонецПроцедуры

Процедура СозданиеТочки(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
	ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
	ОбъявитьТочкуОбмена(КлиентКомпоненты,ТочкаОбмена,?(ЗначениеЗаполнено(Exchange.Тип),Exchange.Тип,Неопределено));
	
КонецПроцедуры

Процедура ПрочитатьСообщениеИзОчереди(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
	ИмяОчереди  = Exchange.ИмяОчереди;
	
	Попытка
		ОбъявитьОчередь(КлиентКомпоненты,ИмяОчереди);
		Потребитель = ЗарегистрироватьПотребителя(КлиентКомпоненты,ИмяОчереди);
		ОтветноеСообщение = "";
        messageTag = 0;
		Если ПолучитьСообщение(КлиентКомпоненты,, ОтветноеСообщение, messageTag) Тогда
			ПодтвердитьПолучениеСообщение(КлиентКомпоненты, messageTag);
			Если СоздатьЗаписьВходящегоСообщения(ОтветноеСообщение,Exchange) тогда
				ТекстСообщения = НСтр("ru='Сообщение успешно прочитано и записано!'");
			Иначе
				ЗаписьЖурналаРегистрации("RMQ.ОшибкаЗаписиСообщения",УровеньЖурналаРегистрации.Ошибка,,ОтветноеСообщение,"Ошибка записи Сообщения");
				ТекстСообщения = НСтр("ru='Сообщение успешно прочитано!'");
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru='Очередь пустая!'");
		КонецЕсли;
		Сообщить(ТекстСообщения);
		ЗакрытьПотребителя(КлиентКомпоненты,Потребитель);
	Исключение
		ПолучитьИнформациюПоПоследнейОшибке(КлиентКомпоненты);
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьЗаписьВходящегоСообщения(Message,Exchange) Экспорт
	
	Результат = Ложь;
	Попытка
		НовоеСообщение = Справочники.RMQ_Сообщения.СоздатьЭлемент();
		НовоеСообщение.Наименование = Строка(Exchange) + " " + Строка(ТекущаяДата());
		НовоеСообщение.Exchange = Exchange;
		НовоеСообщение.ТелоСообщения = Новый ХранилищеЗначения(Message);
		НовоеСообщение.Записать();
		результат = Истина;
	Исключение
		ЗаписьЖурналаРегистрации("RMQ.ОшибкаЗаписиСообщения",УровеньЖурналаРегистрации.Ошибка,,Message,"Ошибка записи Сообщения");
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

Процедура ОтвязатьОчередь(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
	ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
	ИмяОчереди  = СокрЛП(Exchange.ИмяОчереди);
	КлючМаршрутизации = ?(ЗначениеЗаполнено(Exchange.КлючМаршрутизации),Exchange.КлючМаршрутизации,"#");
	ОтсоединитьОчередьОтТочки(КлиентКомпоненты, ИмяОчереди, ТочкаОбмена, КлючМаршрутизации);
	
КонецПроцедуры

Процедура УдалитьОчередь(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
	ИмяОчереди  = СокрЛП(Exchange.ИмяОчереди);
	УдалитьОчередьССервера(КлиентКомпоненты, ИмяОчереди);
	
КонецПроцедуры

Процедура УдалитьТочку(КлиентКомпоненты, Сервер, Exchange) Экспорт
	
	СоединитьсяССервером(КлиентКомпоненты,Сервер);
	ТочкаОбмена = СокрЛП(Exchange.ТочкаОбмена);
	УдалитьТочкуОбмена(КлиентКомпоненты, ТочкаОбмена);
	
КонецПроцедуры


//Connect - устанавливает соединение с сервером RabbitMQ
//Параметры:
//КлиентКомпоненты - компонента
//host - Строка - Адрес сервера RabbitMQ
//port - Число - Порт работы через tcp (обычно 5672)
//login - Строка - Имя пользователя
//pwd - Строка - Пароль пользователя
//vhost - Строка - Vhost пользователя
//pingRate - Число - [НЕ РЕАЛИЗОВАНО][НЕОБЯЗАТЕЛЬНЫЙ]. Частота пульса
Процедура СоединитьсяССервером(КлиентКомпоненты,Сервер) Экспорт
	
	Попытка
		КлиентКомпоненты.Connect(
			Сервер.Адрес,
			Сервер.Порт,
			Сервер.Логин,
			Сервер.Пароль,
			Сервер.ВиртуальныйХост);
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка подключения к " + Сервер + " !%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
			
Конецпроцедуры

//DeclareExchange - Объявить точку обмена
//Параметры:
//КлиентКомпоненты - компонента
//name - Строка - Имя exchange
//type - Строка - Тип точки обмена. Поддерживаются "direct", "fanout", "topic"
//onlyCheckIfExists - Булево - Не создавать новую, выбросить исключение, если такой точки нет.
//durable - Булево - Сохранять сообщения на диске на случай рестарта RMQ (не рекомендуется)
//autodelete - Булево - Удалить после того, как от точки будут отвязаны все очереди.
Процедура ОбъявитьТочкуОбмена(КлиентКомпоненты,Точкаобмена,ТипТочки = "topic",НеСоздаватьНовую = Ложь,Durable = Истина,Autodelete = ложь) Экспорт  
	
	Попытка	
		КлиентКомпоненты.DeclareExchange(ТочкаОбмена, ТипТочки, НеСоздаватьНовую, Durable, Autodelete);	
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка создания Exchange!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
КонецПроцедуры

//DeclareQueue - Объявить очередь
//Параметры:
//КлиентКомпоненты - компонента
//name - Строка - Имя объявляемой очереди.
//onlyCheckIfExists - Булево - Не создавать очередь с таким именем, использовать существующую
//save - Булево - Кешировать сообщения на диске, на случай падения RMQ.
//exclusive - Булево - [НЕ РЕАЛИЗОВАНО] Только текущее соединение может иметь доступ к этой очереди.
//autodelete - Булево - Удалить очередь если к ней был подключен, а затем отключен читающий клиент.
//Возвращаемое значение:
//Имя очереди, заданное явно в 1-м параметре.
Процедура ОбъявитьОчередь(КлиентКомпоненты,ИмяОчереди,НеСоздаватьНовую = Ложь,Save = Истина,Exclusive = Ложь,Autodelete = ложь) Экспорт  
	
	Попытка	
		КлиентКомпоненты.DeclareQueue(ИмяОчереди, НеСоздаватьНовую, Save, Exclusive, Autodelete);	
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка создания очереди " + ИмяОчереди + "!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;		
	
КонецПроцедуры

//BindQueue - Установить связь очереди. Создает маршрут от точки обмена до очереди.
//Параметры:
//КлиентКомпоненты - компонента
//queue - Строка - Имя очереди
//exchange - Строка - Имя точки обмена
//routingKey - Строка - Rлюч маршрутизации.
Процедура УстановитьСвязьОчереди(КлиентКомпоненты,queue,exchange,routingKey) Экспорт

	Попытка	
		КлиентКомпоненты.BindQueue(queue, exchange, routingKey);
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка создания Связи очереди " + queue + " с Exchange " + exchange + "!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
КонецПроцедуры

//BasicPublish - Отправить сообщение
//Параметры:
//КлиентКомпоненты - компонента
//exchange - Строка - Имя точки в которую отправляется сообщение
//routingKey - Строка - Ключ маршрутизации (см. руководство RMQ)
//message - Строка - Тело сообщения
//livingTime - Число - [НЕ РЕАЛИЗОВАНО] Время жизни сообщения в миллисекундах
//persist - Булево - [НЕ РЕАЛИЗОВАНО] Сбрасывать сообщение на диск
Процедура МетодОтправитьСообщение(КлиентКомпоненты,exchange,routingKey,message,livingTime = 1,persist = Ложь) Экспорт
	
	Попытка
		КлиентКомпоненты.BasicPublish(
			exchange,
			routingKey,
			message,
			livingTime,
			persist);
		//Сообщить("Сообщение успешно отправлено!");

	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка отправки сообщения!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьПараметрыСервераRMQ() Экспорт
    Возврат Новый Структура("Адрес, Порт, Логин, Пароль, ВиртуальныйХост", Константы.RMQ_Хост.Получить(), 
    Константы.RMQ_Порт.Получить(), 
    Константы.RMQ_Пользователь.Получить(), 
    Константы.RMQ_Пароль.Получить(), 
    Константы.RMQ_VHost.Получить());
КонецФункции

